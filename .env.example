# Salin menjadi .env.development (dev) atau .env.production (build rilis).
# Hanya variabel berawalan MAIN_VITE_ yang dibaca main process (di-bake saat build).

# Base URL backend: tanpa "/api" di belakangnya.
MAIN_VITE_BACKEND_BASE_URL=http://192.168.1.3/

# Khusus dev dengan Laravel Herd (virtual host). Kosongkan di produksi.
MAIN_VITE_BACKEND_HOST_HEADER=sosmedsign.test
